# Copy to ".env" in the project root (never commit .env).
# Get an API key at https://openrouter.ai/

# Required for POST /simulate (LLM scenario classification)
OPENROUTER_API_KEY=

# Model when a user sends X-OpenRouter-Api-Key (they pay OpenRouter).
# OPENROUTER_MODEL=x-ai/grok-4.1-fast
#
# Model when only the server key is used (no user header). Default: qwen/qwen3.5-flash-02-23. Override e.g. openai/gpt-oss-120b if you prefer.
# OPENROUTER_DEMO_MODEL=qwen/qwen3.5-flash-02-23
