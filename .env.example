# Copy to ".env" in the project root (never commit .env).
# Get an API key at https://openrouter.ai/

# Required for POST /simulate (LLM scenario classification)
OPENROUTER_API_KEY=

# Model when a user sends X-OpenRouter-Api-Key (they pay OpenRouter).
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
#
# Model when only the server key is used (no user header). Default: qwen/qwen3.5-flash-02-23. Override e.g. openai/gpt-oss-120b if you prefer.
# OPENROUTER_DEMO_MODEL=qwen/qwen3.5-flash-02-23
#
# Optional: OpenRouter HTTP read timeout in seconds (default 90).
# OPENROUTER_HTTP_TIMEOUT_SEC=90
# Optional: HTTP-Referer sent to OpenRouter (default: VERCEL_URL or X-Forwarded-Host). Set if your key is site-restricted.
# OPENROUTER_HTTP_REFERER=https://your-deployment.vercel.app
#
# Optional: retry policy for transient OpenRouter failures (timeouts and 429/502/503/504).
# Total attempts including the first try. Default 3.
# OPENROUTER_RETRY_MAX_ATTEMPTS=3
# Base seconds for full-jitter exponential backoff (sleep up to base * 2^(attempt-1)). Default 0.5.
# OPENROUTER_RETRY_BACKOFF_SEC=0.5
